# Hatchling — environment template.
# Copy this file to .env.local and fill in your key.
# .env.local is gitignored so the key never leaves your machine.

# Required to generate art assets. Get one from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional override. Defaults to gemini-2.5-flash-image.
# Other options: gemini-2.0-flash-exp-image-generation, imagen-3.0-generate-002
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ─── Supabase (auth + persistent progress) ──────────────────────
# Get these from https://supabase.com/dashboard/project/_/settings/api
# If unset, the app falls back to localStorage and skips the login flow.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
